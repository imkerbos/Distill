# distill-api 的生产镜像。
#
# 与 Dockerfile.dev 是两回事，不是它的变体：那个装的是完整 Go 工具链与 air，
# 因为热更新要在容器内重新编译。这个只需要跑一个已经编译好的进程。

# 前端产物打进二进制，与 API 同源、同端口、同一份 TLS。
#
# **本机开发不经过这一段**：那时前端跑在独立的 vite dev server 上、走 proxy
# 打后端（CLAUDE.md 的本地开发形态）。正因为开发形态永远碰不到根路径，
# "生产镜像里没有前端" 这件事一直没被发现 —— 部署上去打开首页，拿到的是
# 一句 JSON 的「请求的资源不存在」。
#
# 分开部署一个 nginx 也能服务前端，但那会把开发时特意绕开的跨源问题搬进
# 生产：会话 cookie 是 HttpOnly + SameSite，跨源要额外配 CORS 与
# SameSite=None，还要为前端再配一次证书。
# --platform=$BUILDPLATFORM：这一段跑在**构建机自己的架构**上，不进模拟层。
# 产物是平台无关的 JS/CSS，跨架构消费完全成立；而 vite 的打包器是原生二进制，
# 在 QEMU 里会直接段错误（在 arm64 上构建 amd64 镜像时实测 exit 139）。
FROM --platform=$BUILDPLATFORM node:22-slim AS web
WORKDIR /web
# 先只拷 package 清单：依赖没变时这一层命中缓存。
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# 同样跑在构建机架构上：Go 靠 GOARCH 交叉编译，不需要模拟层，而模拟一个
# 完整的编译过程既慢又多一处会出意外的地方。
FROM --platform=$BUILDPLATFORM golang:1.25 AS build
WORKDIR /src

# 先只拷 go.mod/go.sum：依赖没变时这一层命中缓存，不必每次重拉 k8s.io。
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# 前端产物放到 embed 指令找得到的位置。**必须在 go build 之前** ——
# //go:embed 在编译期读文件，之后再放就进不去二进制了。
COPY --from=web /web/dist/ ./cmd/distill-api/webui/

# CGO_ENABLED=0 是必需的，不是习惯：运行阶段是 distroless static，里面没有 libc。
# -trimpath 去掉构建机的绝对路径，那是部署布局信息。
ARG VERSION=dev
ARG TARGETOS=linux
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
    -ldflags="-s -w -X github.com/imkerbos/Distill/internal/buildinfo.version=${VERSION}" \
    -o /out/distill-api ./cmd/distill-api

# static:nonroot 自带公共 CA 根证书与一个非 root 用户（65532），没有 shell、
# 没有包管理器。进程只需要监听一个端口、连 MySQL、发 HTTPS。
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app

# **迁移目录必须进镜像。** distill-api 启动时自己跑迁移，读的是相对路径
# "migrations"（cmd/distill-api/main.go）—— 不是 embed。少了这一行，进程在
# 启动的第一秒就以 "read migrations" 失败退出，而症状看起来像数据库连不上。
# 同理 WORKDIR 必须是 /app：换一个工作目录，相对路径就指不到这里。
COPY --from=build /src/migrations /app/migrations
COPY --from=build /out/distill-api /app/distill-api

# 配置由 ConfigMap 挂进来，凭据由环境变量从 Secret 注入
# （DISTILL_DATABASE__DSN 等，见 docs/configuration.md）。
EXPOSE 10100
USER 65532:65532
ENTRYPOINT ["/app/distill-api"]
CMD ["-config", "/etc/distill/config.yaml"]
